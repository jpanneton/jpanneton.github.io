{
	"version": "2.0.0",
	// Windows overrides use "bundle.cmd" so the tasks work under Git Bash too.
	// See the Windows notes in Usage.txt.
	"tasks": [
		{
			"label": "Chalk: Serve",
			"detail": "Serve the site locally at http://localhost:4000 (includes drafts)",
			"command": "bundle exec jekyll serve --drafts",
			"windows": {
				"command": "bundle.cmd exec jekyll serve --drafts"
			},
			"type": "shell",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Chalk: Build",
			"detail": "Build the production site into _site",
			"command": "bundle exec jekyll build",
			"windows": {
				"command": "bundle.cmd exec jekyll build"
			},
			"type": "shell",
			"options": {
				"env": {
					"JEKYLL_ENV": "production"
				}
			},
			"problemMatcher": []
		},
		{
			"label": "Chalk: Install dependencies",
			"detail": "bundle install",
			"command": "bundle install",
			"windows": {
				"command": "bundle.cmd install"
			},
			"type": "shell",
			"problemMatcher": []
		},
		{
			"label": "Chalk: Check links",
			"detail": "Build, then run html-proofer over _site",
			"command": "bundle exec jekyll build && bundle exec htmlproofer ./_site",
			"windows": {
				"command": "bundle.cmd exec jekyll build && bundle.cmd exec htmlproofer ./_site"
			},
			"type": "shell",
			"problemMatcher": []
		}
	]
}
